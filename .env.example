# DSN de conexión a BD en localhost
DATABASE_URL=postgresql+asyncpg://locker:locker@localhost:5432/locker
# Claves de API, en JSON de una línea: {"key", "role", "name"} (name solo en carrier). Son de desarrollo, no secretos
API_KEYS=[{"key":"dev-operator-key-000000000","role":"operator"},{"key":"dev-seur-key-0000000000000","role":"carrier","name":"SEUR"},{"key":"dev-correos-key-00000000000","role":"carrier","name":"Correos Express"}]
# Secreto del código de recogida (mínimo 32 caracteres). De desarrollo, no es un secreto
PICKUP_CODE_SECRET=dev-pickup-secret-change-me-0000000000000
# Outbox: intentos antes de dar un aviso por muerto, base de la espera entre reintentos y pausa del worker sin eventos
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=2
OUTBOX_POLL_INTERVAL_SECONDS=1
# Caducidad: segundos que dura una reserva sin depositar antes de caducar y liberar su taquilla
RESERVATION_TTL_SECONDS=1800
